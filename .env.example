# Copy me to .env and fill in (for LOCAL runs only — GitHub Actions uses Secrets)
#   cp .env.example .env

# Gemini API key — https://aistudio.google.com/apikey (free tier is enough)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube OAuth (one-time setup — run `python -m shorts.auth_setup` and follow
# the printed instructions; it prints these three values for you)
YT_CLIENT_ID=xxxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=xxxxx
YT_REFRESH_TOKEN=xxxxx
